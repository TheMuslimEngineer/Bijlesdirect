# ── Bijlesdirect — omgevingsvariabelen ─────────────────────────────
# Kopieer dit bestand naar `.env.local` en vul de waarden in.
# Zonder RESEND_API_KEY werkt het formulier nog steeds; aanvragen
# worden dan alleen gelogd in plaats van gemaild.

# ── Supabase ──
# Te vinden in het Supabase-dashboard onder Project Settings > API.
# De publishable key is bedoeld om in de browser te staan: hij geeft alleen
# toegang tot wat het RLS-beleid toestaat (inzendingen wegschrijven, niet lezen).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Resend ──
# Resend API-key voor het versturen van intake-/contactmails.
# Aanmaken op https://resend.com (gratis tier beschikbaar).
RESEND_API_KEY=

# Naar welk e-mailadres de aanvragen worden gestuurd.
INTAKE_TO=info@bijlesdirect.nl

# Afzender. Gebruik pas een eigen adres (bijv. "Bijlesdirect <intake@bijlesdirect.nl>")
# nadat het domein bijlesdirect.nl in Resend is geverifieerd.
INTAKE_FROM=Bijlesdirect <onboarding@resend.dev>

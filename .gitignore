# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — nooit meecommitten, behalve deze twee.
#
# .env.example    documenteert welke variabelen nodig zijn (geen waarden)
# .env.production bevat UITSLUITEND publieke waarden, zodat de hostingomgeving
#                 ze automatisch oppikt bij het bouwen.
#
# Alles wat geheim is — RESEND_API_KEY, de Supabase service role key,
# wachtwoorden — hoort NOOIT in een van deze bestanden, want de repo is publiek.
.env*
!.env.example
!.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# skills die via `npx skills add` zijn opgehaald — inhoud van derden.
# skills-lock.json committen we wél, zodat versies reproduceerbaar zijn.
/.agents/
/.claude/skills/
